  "annotations": [
    { "id": "direction", "x": 0, "y": -200, "w": 520, "text": "Direction A · “Daylight” — the working day as a strip of light.\nGreen is only ever spare time. Blue = other people's meetings. Dark = blocks you chose. Amber = gently over. Ember appears only for a real deadline.\nType: Instrument Serif (the numbers), Instrument Sans (UI), DM Mono (times).\nStatic mockups — nothing is clickable yet." },
    { "id": "ribbon-states", "x": 1540, "y": -150, "w": 420, "text": "The spare-time ribbon has three states: spare (green), fits exactly (grey), over (amber with a soft tail). Never red, never a count of overdue tasks." },
    { "id": "responsive", "x": 3990, "y": 2080, "w": 420, "text": "Every screen is responsive. Same data, same tokens, one layout per width: three panes ≥1180px · two panes 900–1179 · icon rail 640–899 · phone below 640 (tab bar Today · Inbox · Week · Browse, sheets, 44px targets, tap-to-schedule instead of drag)." },
    { "id": "phone-flows", "x": 3920, "y": 3160, "w": 420, "text": "Phone · every M1 screen. This row: sign in → onboarding 1–4 (the reveal, step 5, is in the row above), then Inbox, the Day timeline placing a task by tap, and task detail.\nNext row: project, Browse (areas, Someday, Logbook, Settings), evening shutdown, search & commands, settings, logbook." },
    { "id": "alternates", "x": 1980, "y": 5120, "w": 380, "text": "Two low-fi alternates in case Daylight isn't it. Pick one and I'll rebuild the whole set in that direction." }
  ],
  "launch": { "view": "canvas" }
