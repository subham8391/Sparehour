{
  // The type check (npm run typecheck). A shared file in ../src looks for its packages upwards from where it is, which
  // is the web app's node_modules: another copy at another version of React and the sync kit, and nothing at all where
  // only this folder is installed (CI's mobile job). Every package the shared files import is pinned here to this
  // folder's copy. A new package imported under ../src/core or ../src/data needs a line here and in package.json.
  // Kept out of tsconfig.json because Metro and Jest read that file's paths as real module addresses.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "@/data/powersync": ["./src/sync/adapter.ts"],
      "@/*": ["../src/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "@powersync/web": ["./node_modules/@powersync/react-native/lib/index.d.ts"],
      "@powersync/react": ["./node_modules/@powersync/react/lib/index.d.ts"],
      "temporal-polyfill": ["./node_modules/temporal-polyfill/index.d.ts"],
      "rrule": ["./node_modules/rrule/dist/esm/index.d.ts"],
      "chrono-node/en": ["./node_modules/chrono-node/dist/esm/locales/en/index.d.ts"],
      "fractional-indexing-jittered": ["./node_modules/fractional-indexing-jittered/lib/index.d.ts"]
    }
  }
}
