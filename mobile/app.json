{
  "expo": {
    "name": "Sparehour",
    "slug": "sparehour",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sparehour",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sparehour.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4f8f6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sparehour.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e8f0fa",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#101b3a",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain"]
          }
        }
      ],
      [
        "./plugins/app-shortcuts",
        {
          "shortcuts": [
            { "name": "Add a task", "short_name": "Add", "url": "/today?quickadd=1" },
            { "name": "Today", "short_name": "Today", "url": "/today" }
          ]
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    },
    "extra": {
      "eas": {
        "projectId": "98bb5282-e914-48c0-a76b-5703f90be4cd"
      }
    },
    "owner": "subhamdas23",
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
