# Copy to mobile/.env (never committed) and fill in. All four are public by nature: Expo puts EXPO_PUBLIC_* values
# into the app when it is built. Nothing secret belongs here.
#
# The Sparehour web app this build talks to (it mints the sync token and takes the uploads).
EXPO_PUBLIC_APP_URL=
# The PowerSync service itself (the instance URL from the PowerSync dashboard; locally http://<this Mac's address>:8080).
EXPO_PUBLIC_POWERSYNC_URL=
# The same two values the web app has as NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
