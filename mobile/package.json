    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "jest-message-util": "^30.5.1",
    "jest-util": "^30.5.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "jest",
    "bundle": "expo export --platform android --output-dir dist",
    "preview": "expo start --web --port 8090"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleDirectories": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^chrono-node/en$": "<rootDir>/node_modules/chrono-node/dist/cjs/locales/en/index.js",
      "^~/(.*)$": "<rootDir>/src/$1",
      "^@/data/powersync$": "<rootDir>/src/sync/adapter.ts",
      "^(\\.\\./|\\./)+powersync$": "<rootDir>/src/sync/adapter.ts",
      "^@/(.*)$": "<rootDir>/../src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|standard-navigation|@powersync|temporal-polyfill|temporal-utils))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "overrides": {
    "@react-native/jest-preset": {
      "jest-environment-node": "^30.0.0",
      "babel-jest": "^30.0.0"
    }
  }
}
