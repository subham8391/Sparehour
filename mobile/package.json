{
  "name": "sparehour-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@powersync/react-native": "^2.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "chrono-node": "2.10.1",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "fractional-indexing-jittered": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "rrule": "2.8.1",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "jest",
    "bundle": "expo export --platform android --output-dir dist",
    "preview": "expo start --web --port 8090"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleDirectories": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/src/$1",
      "^@/data/powersync$": "<rootDir>/src/sync/adapter.ts",
      "^(\\.\\./|\\./)+powersync$": "<rootDir>/src/sync/adapter.ts",
      "^@/(.*)$": "<rootDir>/../src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|standard-navigation|@powersync|temporal-polyfill|temporal-utils))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
